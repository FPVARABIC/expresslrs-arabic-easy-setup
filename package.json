{
  "name": "expresslrs-arabic-easy-setup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "check:boundaries": "node scripts/check-dependency-boundaries.mjs",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:master-plan": "node scripts/check-master-plan.mjs",
    "licenses:report": "pnpm licenses list --recursive --json > dependency-licenses.json",
    "licenses:check": "node scripts/check-license-policy.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm check:links && pnpm check:master-plan && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
