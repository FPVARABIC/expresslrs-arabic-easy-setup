{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@elrs-easy/compatibility": ["packages/compatibility/src/index.ts"],
      "@elrs-easy/device": ["packages/device/src/index.ts"],
      "@elrs-easy/domain": ["packages/domain/src/index.ts"],
      "@elrs-easy/i18n": ["packages/i18n/src/index.ts"],
      "@elrs-easy/platform-browser": ["packages/platform-browser/src/index.ts"],
      "@elrs-easy/platform-mock": ["packages/platform-mock/src/index.ts"],
      "@elrs-easy/workflows": ["packages/workflows/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  }
}
