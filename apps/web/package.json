{
  "name": "@elrs-easy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node ../../scripts/build-pwa-worker.mjs && node ../../scripts/check-security-headers.mjs --built && node ../../scripts/check-pwa-safety.mjs --built",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@elrs-easy/compatibility": "workspace:*",
    "@elrs-easy/device": "workspace:*",
    "@elrs-easy/diagnostics": "workspace:*",
    "@elrs-easy/domain": "workspace:*",
    "@elrs-easy/i18n": "workspace:*",
    "@elrs-easy/platform-browser": "workspace:*",
    "@elrs-easy/platform-mock": "workspace:*",
    "@elrs-easy/workflows": "workspace:*",
    "@fontsource-variable/cairo": "5.3.0",
    "esptool-js": "0.6.0",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
